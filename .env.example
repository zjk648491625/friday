# Friday Build Environment Configuration
# Copy this file to .env and customize for your machine.
# DO NOT commit .env to version control.

# ---------------------------------------------------------------------------
# JDK Path (for running Gradle)
# Used by: extensions/intellij/gradle.properties -> org.gradle.java.home
# If unset, Gradle auto-detects via JAVA_HOME or system PATH.
# ---------------------------------------------------------------------------
# GRADLE_JAVA_HOME=D:/soft/Java/jdk-17

# ---------------------------------------------------------------------------
# Maven Local Repository
# Used by: extensions/intellij/build.gradle.kts -> mavenLocal()
# If unset, defaults to ~/.m2/repository (standard Maven location).
# ---------------------------------------------------------------------------
# M2_REPO=D:/soft/mavenrepo
# M2_HOME=D:/soft/maven

# ---------------------------------------------------------------------------
# Gradle Distribution Mirror
# Used by: extensions/intellij/gradle/wrapper/gradle-wrapper.properties
# Override the default official Gradle distribution URL.
# Useful for users in China or behind corporate firewalls.
# ---------------------------------------------------------------------------
# GRADLE_DISTRIBUTION_URL=https://mirrors.cloud.tencent.com/gradle/gradle-8.14.3-bin.zip
# GRADLE_DISTRIBUTION_URL=https://mirrors.aliyun.com/gradle/gradle-8.14.3-bin.zip

# ---------------------------------------------------------------------------
# Node Version Manager
# This project is verified to build with Node 20.x.
# Node 24+ may fail due to native module compilation (sqlite3/keytar).
# Use nvm/fnm to switch versions if needed.
# ---------------------------------------------------------------------------
# NODE_VERSION=20.20.1