<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.fridayai.fridayintellijextension</id>
    <name>Friday AI</name>
    <vendor url="https://www.IronHero.com/">IronHero</vendor>
    <description><![CDATA[
Friday AI is an AI-powered coding assistant that helps developers write better code faster with intelligent code completions and more.
]]></description>
    <change-notes>
        <![CDATA[IronHero - AI-powered coding assistant]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends optional="true" config-file="friday-jcef.xml">com.intellij.modules.jcef</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Friday" anchor="right" icon="com.github.fridayai.fridayintellijextension.Icons.Friday"
                    factoryClass="com.github.fridayai.fridayintellijextension.toolWindow.FridayPluginToolWindowFactory"/>
        <projectService id="FridayPluginService"
                        serviceImplementation="com.github.fridayai.fridayintellijextension.services.FridayPluginService"/>
        <projectService
                id="DiffStreamService"
                serviceImplementation="com.github.fridayai.fridayintellijextension.editor.DiffStreamService"/>

        <projectService serviceInterface="com.github.fridayai.fridayintellijextension.autocomplete.CompletionService"
                        serviceImplementation="com.github.fridayai.fridayintellijextension.autocomplete.FridayCompletionService"/>
        <projectService
                serviceInterface="com.github.fridayai.fridayintellijextension.nextEdit.NextEditService"
                serviceImplementation="com.github.fridayai.fridayintellijextension.nextEdit.FridayNextEditService"/>

        <projectService
                serviceImplementation="com.github.fridayai.fridayintellijextension.nextEdit.NextEditWindowManager"/>

        <projectService
                serviceImplementation="com.github.fridayai.fridayintellijextension.nextEdit.NextEditJumpManager"/>

        <inline.completion.provider id="Friday" implementation="com.github.fridayai.fridayintellijextension.autocomplete.FridayInlineCompletionProvider"/>
        
        <notificationGroup id="Friday"
                           displayType="BALLOON"/>
        <actionPromoter order="last"
                        implementation="com.github.fridayai.fridayintellijextension.actions.FridayActionPromote"/>
        <postStartupActivity
                implementation="com.github.fridayai.fridayintellijextension.activities.FridayPluginStartupActivity"/>
        <postStartupActivity implementation="com.github.fridayai.fridayintellijextension.proxy.ProxyPoolingActivity"/>
        <applicationConfigurable
                parentId="tools"
                instance="com.github.fridayai.fridayintellijextension.services.FridayExtensionConfigurable"
                id="com.github.fridayai.fridayintellijextension.fridayintellijextension.services.FridayExtensionConfigurable"
                displayName="Friday AI"/>
        <applicationService
                serviceImplementation="com.github.fridayai.fridayintellijextension.services.FridayExtensionSettings"/>

        <checkinHandlerFactory
                implementation="com.github.fridayai.fridayintellijextension.friday.CommitMessageGeneratorFactory"/>
    </extensions>

    <actions>
        <action class="com.github.fridayai.fridayintellijextension.editor.InlineEditAction"
                id="friday.inlineEdit"
                description="Inline Edit"
                text="Inline Edit">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="ctrl I"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="meta I"/>
            <override-text place="GoToAction" text="Friday: Edit Code"/>
        </action>

        <action id="friday.acceptDiff"
                class="com.github.fridayai.fridayintellijextension.actions.AcceptDiffAction"
                text="Accept Diff" description="Accept Diff">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="shift ctrl ENTER"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="shift meta ENTER"/>
            <override-text place="GoToAction" text="Friday: Accept Diff"/>
        </action>

        <action id="friday.restartProcess"
                class="com.github.fridayai.fridayintellijextension.actions.RestartFridayProcess"
                text="Restart Process"
                description="Restart Process">
            <override-text place="GoToAction" text="Friday: Restart Process"/>
        </action>

        <action id="friday.rejectDiff"
                class="com.github.fridayai.fridayintellijextension.actions.RejectDiffAction"
                text="Reject Diff" description="Reject Diff">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="shift ctrl BACK_SPACE"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="shift meta BACK_SPACE"/>
            <override-text place="GoToAction" text="Friday: Reject Diff"/>
        </action>

        <action id="friday.acceptVerticalDiffBlock"
                class="com.github.fridayai.fridayintellijextension.actions.AcceptDiffAction"
                text="Accept Diff" description="Accept Vertical Diff Block">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="alt shift Y"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="alt shift Y"/>
            <override-text place="GoToAction" text="Friday: Accept Vertical Diff Block"/>
        </action>

        <action id="friday.rejectVerticalDiffBlock"
                class="com.github.fridayai.fridayintellijextension.actions.RejectDiffAction"
                text="Reject Diff" description="Reject Vertical Diff Block">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="alt shift N"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="alt shift N"/>
            <override-text place="GoToAction" text="Friday: Reject Vertical Diff Block"/>
        </action>

        <action id="friday.addLicenseKey"
                class="com.github.fridayai.fridayintellijextension.license.AddLicenseKey"
                text="Enter Enterprise License Key"
                description="Enter Enterprise License Key">
            <override-text place="GoToAction" text="Friday: Enter Enterprise License Key"/>
        </action>

        <action id="friday.focusFridayInputWithoutClear"
                class="com.github.fridayai.fridayintellijextension.actions.FocusFridayInputWithoutClearAction"
                text="Add selected code to context"
                description="Focus Friday Input With Edit">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="ctrl shift J"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="meta shift J"/>
            <override-text place="GoToAction" text="Friday: Add Highlighted Code to Context"/>
        </action>

        <action id="friday.newFridaySession"
                icon="AllIcons.General.Add"
                class="com.github.fridayai.fridayintellijextension.actions.NewFridaySessionAction"
                text="New Session"
                description="New Session">

            <override-text place="GoToAction" text="New Session"/>
        </action>

        <action id="friday.viewHistory"
                icon="AllIcons.Vcs.History"
                class="com.github.fridayai.fridayintellijextension.actions.ViewHistoryAction"
                text="View History"
                description="View History">
            <override-text place="GoToAction" text="View History"/>
        </action>

        <action id="friday.openConfigPage"
                class="com.github.fridayai.fridayintellijextension.actions.OpenConfigAction"
                icon="AllIcons.General.GearPlain"
                text="Settings"
                description="Settings">
            <override-text place="GoToAction" text="Settings"/>
        </action>

        <action id="friday.reloadPage"
                class="com.github.fridayai.fridayintellijextension.actions.ReloadBrowserAction"
                icon="AllIcons.Actions.Refresh"
                text="Reload Friday Browser"
                description="Reload Friday Browser">
            <override-text place="GoToAction" text="Reload Friday Browser"/>
        </action>

        <action id="friday.openLogs"
                class="com.github.fridayai.fridayintellijextension.actions.OpenLogsAction"
                icon="AllIcons.General.ShowInfos"
                text="Open Logs"
                description="Open Friday Logs">
            <override-text place="GoToAction" text="Open Friday Logs"/>
        </action>

        <group id="FridaySidebarActionsGroup">
            <reference ref="friday.newFridaySession"/>
            <reference ref="friday.viewHistory"/>
            <reference ref="friday.openConfigPage"/>
            <reference ref="friday.reloadPage" />
        </group>

        <action id="friday.focusFridayInput"
                class="com.github.fridayai.fridayintellijextension.actions.FocusFridayInputAction"
                text="Add selected code to context"
                description="Focus Friday Input">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="ctrl J"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="meta J"/>
            <add-to-group group-id="EditorPopupMenu"/>
            <override-text place="GoToAction" text="Friday: Add Highlighted Code to Context and Clear Chat"/>
        </action>

        <action id="friday.generateCommitMessage"
                class="com.github.fridayai.fridayintellijextension.actions.GenerateCommitMessageAction"
                text="AI 生成提交信息"
                description="使用 Friday AI 根据 Git diff 自动生成提交信息"
                icon="AllIcons.Actions.Lightning">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="ctrl alt G"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="meta shift G"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="VcsGlobalGroup" anchor="last"/>
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="last"/>
            <override-text place="GoToAction" text="Friday: AI 生成提交信息"/>
        </action>
        <group id="FridayProjectViewPopUpMenuGroup" popup="true" text="Friday" icon="/icons/friday.svg">
            <action id="com.github.fridayai.fridayintellijextension.fridayintellijextension.actions.AddToChatAction"
                    class="com.github.fridayai.fridayintellijextension.actions.AddToChatAction"
                    text="Add to Chat">
            </action>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
