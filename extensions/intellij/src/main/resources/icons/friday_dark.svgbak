<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- 全息冰蓝渐变（星期五标志色） -->
    <linearGradient id="fridayCyan" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#E0F7FA" />
      <stop offset="50%" stop-color="#00E5FF" />
      <stop offset="100%" stop-color="#00838F" />
    </linearGradient>

    <!-- 赛博暗夜蓝（骨架阴影色） -->
    <linearGradient id="cyberDark" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#006064" stop-opacity="0.2"/>
      <stop offset="100%" stop-color="#002D32" stop-opacity="0.8"/>
    </linearGradient>

    <!-- 强光发光滤镜 -->
    <filter id="neonGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>

    <!-- 弱发光滤镜（用于背景波纹） -->
    <filter id="subtleGlow" x="-10%" y="-10%" width="120%" height="120%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- 全透明背景，直接进入AI面具主体 -->
  <g filter="url(#subtleGlow)">

    <!-- === 1. 星期五虚拟全息外壳 (代替传统的红色外盔) === -->
    <!-- 使用半透明科技蓝，营造出数字化能量体面具的质感 -->
    <path d="M 160 80 L 352 80 L 400 160 L 410 280 L 370 380 L 330 440 L 256 460 L 182 440 L 142 380 L 102 280 L 112 160 Z"
          fill="url(#cyberDark)" stroke="#00E5FF" stroke-width="2" stroke-dasharray="12,6" opacity="0.8"/>

    <!-- === 2. 核心机甲面具线条 (金色面具位置转化) === -->
    <!-- 采用全息光线勾勒的战甲面部切面 -->
    <path d="M 165 150 L 347 150 L 375 220 L 370 340 L 320 420 L 256 425 L 192 420 L 142 340 L 137 220 Z"
          fill="none" stroke="url(#fridayCyan)" stroke-width="4" stroke-linejoin="round"/>

    <!-- 面具额头倒V型全息分件线 -->
    <path d="M 190 150 L 256 200 L 322 150" fill="none" stroke="#00E5FF" stroke-width="2" opacity="0.6"/>

    <!-- === 3. AI 数字化声波纹理 (融入星期五的波形特征) === -->
    <!-- 脸颊两侧的数字音频振幅线条 -->
    <path d="M 150 260 Q 170 280 160 300 T 170 340" fill="none" stroke="#00E5FF" stroke-width="1.5" opacity="0.5" />
    <path d="M 362 260 Q 342 280 352 300 T 342 340" fill="none" stroke="#00E5FF" stroke-width="1.5" opacity="0.5" />
    <path d="M 175 350 Q 215 370 256 370 T 337 350" fill="none" stroke="#00E5FF" stroke-width="1" stroke-dasharray="2,4" opacity="0.7" />

    <!-- === 4. 纯白高亮量子眼 (极具人工智能的深邃感) === -->
    <!-- 左眼 -->
    <polygon points="165,245 225,250 215,268 170,265" fill="#FFFFFF" stroke="#00E5FF" stroke-width="2" filter="url(#neonGlow)"/>
    <!-- 右眼 -->
    <polygon points="347,245 287,250 297,268 342,265" fill="#FFFFFF" stroke="#00E5FF" stroke-width="2" filter="url(#neonGlow)"/>

    <!-- === 5. 额头核心厂牌标识：汉字 “五” === -->
    <!-- 呼应 F.R.I.D.A.Y. (星期五) 身份，采用硬朗、富有切角的赛博朋克风汉字设计 -->
    <g filter="url(#neonGlow)">
      <path d="M 215 100 L 297 100 M 225 118 L 287 118 M 256 118 L 240 150 M 275 118 L 275 152 M 220 152 L 295 152"
            fill="none"
            stroke="#FFFFFF"
            stroke-width="5"
            stroke-linecap="square"
            stroke-linejoin="miter"/>
    </g>

    <!-- 下嘴唇极简中轴线 -->
    <line x1="256" y1="390" x2="256" y2="425" stroke="#00E5FF" stroke-width="2" stroke-dasharray="4,4" opacity="0.6" />
  </g>
</svg>
