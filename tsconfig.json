{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "packages/**/src/**/*.ts", "core/**/*.ts", "gui/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "gui/dist", "gui/node_modules", "**/*.test.ts", "**/*.spec.ts", "**/test/**"]
}
